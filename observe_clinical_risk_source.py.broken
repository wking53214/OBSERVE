from __future__ import annotations import asyncio import hashlib import json import logging import math import threading import copy from collections import OrderedDict from dataclasses import dataclass, field, asdict from datetime import datetime, timezone from enum import Enum from typing import Dict, List, Optional, Any, Callable from uuid import uuid4 logger = logging.getLogger("OBSERVE") # ============================================================================ # ENUMS # ============================================================================ class OperationalRegime(Enum): STABLE = "stable" CAUTION = "caution" WARNING = "warning" CRITICAL = "critical" class JobStatus(Enum): QUEUED = "queued" RUNNING = "running" COMPLETED = "completed" FAILED = "failed" # ============================================================================ # DATA CONTRACTS # ============================================================================ @dataclass(frozen=True) class VitalsSnapshot: patient_id: str timestamp: datetime heart_rate: float oxygen_saturation: float respiratory_rate: float temperature: float context: Dict[str, Any] = field(default_factory=dict) @dataclass class RiskOutput: engine_name: str risk_score: float confidence: float regime_classification: Dict[str, float] triggered_rules: List[str] timestamp: datetime debug_info: Dict[str, Any] = field(default_factory=dict) abstained: bool = False @dataclass class FusedVerdict: risk_score: float regime: OperationalRegime confidence: float entropy: float active_engines: List[str] triggered_rules: List[str] timestamp: datetime audit_hash: str = "" decision_fingerprint: str = "" escalation_required: bool = False @dataclass class ScheduledJob: patient_id: str vitals_snapshot: Dict[str, Any] job_id: str = field(default_factory=lambda: str(uuid4())[:8]) status: JobStatus = JobStatus.QUEUED retry_count: int = 0 max_retries: int = 3 final_result: Optional[Dict[str, Any]] = None # ============================================================================ # CLINICAL NORMS # ============================================================================ PEDIATRIC_NORMS = { "neonatal": {"hr_high": 160, "hr_low": 80, "rr_high": 50, "o2_low": 90, "temp_high": 38.5}, "infant": {"hr_high": 150, "hr_low": 90, "rr_high": 45, "o2_low": 90, "temp_high": 39.0}, "toddler": {"hr_high": 140, "hr_low": 95, "rr_high": 40, "o2_low": 91, "temp_high": 39.0}, "child": {"hr_high": 130, "hr_low": 100, "rr_high": 35, "o2_low": 92, "temp_high": 39.5}, "generic": {"hr_high": 140, "hr_low": 95, "rr_high": 40, "o2_low": 91, "temp_high": 39.0}, } DRIFT_SIGMA_THRESHOLD = 2.0 # ============================================================================ # SAFETY: VITAL VALIDATION # ============================================================================ VITALS_PHYSICAL_BOUNDS = { "heart_rate": (0.0, 350.0), "oxygen_saturation": (0.0, 100.0), "respiratory_rate": (0.0, 150.0), "temperature": (20.0, 45.0), } def validate_vitals(v: VitalsSnapshot) -> List[str]: faults = [] for k, (lo, hi) in VITALS_PHYSICAL_BOUNDS.items(): val = getattr(v, k, None) if not isinstance(val, (int, float)) or not math.isfinite(val): faults.append(f"{k}=nonfinite") elif not (lo <= val <= hi): faults.append(f"{k}=out_of_range") return faults def regime_distribution(score: float) -> Dict[str, float]: score = max(0.0, min(1.0, score)) if score >= 0.75: d = {"stable": 0.05, "caution": 0.10, "warning": 0.25, "critical": 0.60} elif score >= 0.50: d = {"stable": 0.10, "caution": 0.20, "warning": 0.55, "critical": 0.15} elif score >= 0.25: d = {"stable": 0.35, "caution": 0.50, "warning": 0.12, "critical": 0.03} else: d = {"stable": 0.88, "caution": 0.08, "warning": 0.03, "critical": 0.01} return d def fingerprint(payload: Dict[str, Any]) -> str: return hashlib.sha256( json.dumps(payload, sort_keys=True, default=str).encode() ).hexdigest() def age_group(age_months: Optional[int]) -> str: if age_months is None: return "generic" if age_months < 3: return "neonatal" if age_months < 12: return "infant" if age_months < 36: return "toddler" return "child" # ============================================================================ # ADAPTERS # ============================================================================ class RiskAdapters: @staticmethod def heuristic(v: VitalsSnapshot) -> RiskOutput: ctx = v.context age = age_group(ctx.get("age_months")) n = PEDIATRIC_NORMS[age] score = 0.0 triggered = [] if v.oxygen_saturation < n["o2_low"]: score += 0.3 triggered.append("low_o2") if v.heart_rate > n["hr_high"]: score += 0.2 triggered.append("tachy") if v.temperature > n["temp_high"]: score += 0.1 triggered.append("fever") confidence = 0.9 if ctx.get("age_months") is not None else 0.7 return RiskOutput( "heuristic", min(score, 1.0), confidence, regime_distribution(score), triggered, datetime.now(timezone.utc), ) @staticmethod def bayesian(v: VitalsSnapshot) -> RiskOutput: ctx = v.context age = age_group(ctx.get("age_months")) n = PEDIATRIC_NORMS[age] o2_dev = (n["o2_low"] - v.oxygen_saturation) / 5.0 hr_dev = (v.heart_rate - n["hr_high"]) / 10.0 score = 0.0 triggered = [] debug = {"o2_dev": o2_dev, "hr_dev": hr_dev} if o2_dev > 2: score += 0.5 triggered.append("o2_dev") if abs(hr_dev) > 2: score += 0.3 triggered.append("hr_dev") return RiskOutput( "bayesian", min(score, 1.0), 0.85, regime_distribution(score), triggered, datetime.now(timezone.utc), debug, ) @staticmethod def trajectory(v: VitalsSnapshot) -> RiskOutput: prev_o2 = v.context.get("previous_o2") if prev_o2 is None: return RiskOutput( "trajectory", 0.0, 0.2, regime_distribution(0.0), ["abstain"], datetime.now(timezone.utc), abstained=True, ) delta = v.oxygen_saturation - prev_o2 score = min(max(abs(delta) / 10.0, 0.0), 1.0) return RiskOutput( "trajectory", score, 0.6, regime_distribution(score), ["trend"], datetime.now(timezone.utc), ) @staticmethod def drift(v: VitalsSnapshot) -> RiskOutput: hist = v.context.get("history_o2", []) if len(hist) < 5: return RiskOutput( "drift", 0.0, 0.3, regime_distribution(0.0), ["abstain"], datetime.now(timezone.utc), abstained=True, ) mean = sum(hist) / len(hist) var = sum((x - mean) ** 2 for x in hist) / len(hist) z = abs(v.oxygen_saturation - mean) / (math.sqrt(var) + 1e-6) score = min(z / 5.0, 1.0) return RiskOutput( "drift", score, 0.7, regime_distribution(score), ["drift"] if score > 0.5 else [], datetime.now(timezone.utc), ) @staticmethod def behavioral(v: VitalsSnapshot) -> RiskOutput: score = 0.0 triggered = [] if v.oxygen_saturation < 92 and v.heart_rate > 140: score += 0.4 triggered.append("stress_combo") if v.respiratory_rate > 40: score += 0.3 triggered.append("tachypnea") return RiskOutput( "behavioral", min(score, 1.0), 0.8, regime_distribution(score), triggered, datetime.now(timezone.utc), ) @staticmethod def adversarial(v: VitalsSnapshot) -> RiskOutput: hist = v.context.get("recent_o2_readings", []) if len(hist) < 5: return RiskOutput( "adversarial", 0.0, 0.6, regime_distribution(0.0), ["abstain"], datetime.now(timezone.utc), abstained=True, ) if len(set(hist[-5:])) == 1: return RiskOutput( "adversarial", 0.3, 0.7, regime_distribution(0.3), ["stuck_sensor"], datetime.now(timezone.utc), ) return RiskOutput( "adversarial", 0.1, 0.7, regime_distribution(0.1), [], datetime.now(timezone.utc), ) # ============================================================================ # FUSION # ============================================================================ class Fusion: @staticmethod def fuse(outputs: List[RiskOutput]): active = [o for o in outputs if not o.abstained] pool = active if active else outputs if not pool: return 0.0, 0.0, regime_distribution(0.0) w = sum(o.confidence for o in pool) or 1.0 risk = sum(o.risk_score * o.confidence for o in pool) / w regime = {"stable": 0, "caution": 0, "warning": 0, "critical": 0} for o in pool: for k, v in o.regime_classification.items(): regime[k] += v * o.confidence regime = {k: v / w for k, v in regime.items()} entropy = -sum(p * math.log2(p + 1e-9) for p in regime.values()) return risk, entropy, regime # ============================================================================ # ENGINE # ============================================================================ class ObserveClinicalEngine: def __init__(self): self.audit = [] self._policies = OrderedDict() self._lock = threading.Lock() def _policy(self, pid: str): with self._lock: if pid not in self._policies: self._policies[pid] = {"regime": OperationalRegime.STABLE} return self._policies[pid] def evaluate(self, v: VitalsSnapshot) -> FusedVerdict: faults = validate_vitals(v) policy = self._policy(v.patient_id) if faults: return FusedVerdict( 0.0, OperationalRegime.WARNING, 0.0, 0.0, [], ["fault"] + faults, datetime.now(timezone.utc), ) outputs = [ RiskAdapters.heuristic(v), RiskAdapters.bayesian(v), RiskAdapters.trajectory(v), RiskAdapters.drift(v), RiskAdapters.behavioral(v), RiskAdapters.adversarial(v), ] risk, entropy, regime = Fusion.fuse(outputs) top = max(regime, key=regime.get) final = OperationalRegime(top) escalation = final.value in ("warning", "critical") policy["regime"] = final payload = { "vitals": asdict(v), "risk": risk, "regime": final.value, "entropy": entropy, } return FusedVerdict( risk, final, sum(o.confidence for o in outputs) / len(outputs), entropy, [o.engine_name for o in outputs], [], datetime.now(timezone.utc), fingerprint(payload), escalation, )