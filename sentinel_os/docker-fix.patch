+# Required. The ledger refuses to start without a declared, non-owner
+# runtime identity -- there is no privileged fallback. ledger_reader is
+# created automatically by ledger_immutability.sql; its password is
+# self-provisioned from RUNTIME_PASSWORD on every startup, so you only
+# need to set these two values, not create the role or set its password
+# separately.
+ICEBERG_LEDGER_RUNTIME_USER=ledger_reader
+ICEBERG_LEDGER_RUNTIME_PASSWORD=
+
 # Required for live governance decisions. Without it the governor runs in
 # fail-closed no-client mode (see claude_governance_api.py).
 CLAUDE_API_KEY=
