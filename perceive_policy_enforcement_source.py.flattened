from __future__ import annotations import hashlib import hmac import json import logging import math from dataclasses import dataclass, field, asdict from datetime import datetime, timezone from typing import Dict, List, Optional, Tuple, Any logger = logging.getLogger("PERCEIVE") logger.setLevel(logging.INFO) if not logger.handlers: handler = logging.StreamHandler() handler.setFormatter(logging.Formatter("[PERCEIVE] %(asctime)s %(levelname)s %(message)s")) logger.addHandler(handler) # ============================================================================ # DATA CONTRACTS # ============================================================================ @dataclass class Provenance: actor_id: str policy_id: str justification: str @dataclass class PolicyOutput: gate_name: str approved: bool confidence: float violation_details: List[str] timestamp: datetime provenance: Provenance @dataclass class PolicyRequest: request_id: str request_type: str subject_id: str actor_id: str context: Dict[str, Any] = field(default_factory=dict) timestamp: Optional[datetime] = None @dataclass class PolicyManifest: manifest_id: str version: str created_at: datetime policies: Dict[str, Dict] = field(default_factory=dict) manifest_hash: str = "" @dataclass class PolicyVerdict: request_id: str approved: bool confidence: float violations: List[str] applied_gates: List[str] policy_version: str provenance: Provenance audit_hash: str consensus_result: Optional[Dict[str, Any]] = None @dataclass class Event: event_id: str event_type: str timestamp: datetime request_snapshot: Dict actor_id: str details: Dict = field(default_factory=dict) @dataclass class AuditEntry: audit_id: str timestamp: datetime request_snapshot: Dict evaluated_gates: List[str] policy_outputs: List[Dict] final_verdict: Dict manifest_version: str manifest_hash: str previous_hash: str = "" immutable_hash: str = "" # ============================================================================ # POLICY RULES # ============================================================================ class EscalationPolicy: MAX_ESCALATIONS_PER_DAY = 10 MAX_ESCALATIONS_PER_HOUR = 3 MIN_TIME_BETWEEN_ESCALATIONS_MINUTES = 15 @staticmethod def can_escalate(current_risk_tier: str, escalations_today: int, escalations_this_hour: int, minutes_since_last: int) -> Tuple[bool, List[str]]: violations = [] if escalations_today >= EscalationPolicy.MAX_ESCALATIONS_PER_DAY: violations.append("Daily limit reached") if escalations_this_hour >= EscalationPolicy.MAX_ESCALATIONS_PER_HOUR: violations.append("Hourly limit reached") if minutes_since_last < EscalationPolicy.MIN_TIME_BETWEEN_ESCALATIONS_MINUTES: violations.append("Cooldown active") return len(violations) == 0, violations class RuleModificationPolicy: @staticmethod def can_modify(rule_type: str, approvals: int, hours_since: int) -> Tuple[bool, List[str]]: levels = { "non_critical": (1, 0), "critical": (2, 24), "safety_critical": (3, 72), } if rule_type not in levels: return False, ["Unknown rule type"] required, lock = levels[rule_type] v = [] if approvals < required: v.append("Insufficient approvals") if hours_since < lock: v.append("Temporal lock active") return len(v) == 0, v class DataExportPolicy: @staticmethod def can_export(export_type: str, consent: bool, audit: bool, encrypt: bool) -> Tuple[bool, List[str]]: rules = { "pii_included": (True, True, True), "synthetic_only": (False, True, False), "aggregate_only": (False, False, False), } if export_type not in rules: return False, ["Unknown export type"] req_c, req_a, req_e = rules[export_type] v = [] if req_c and not consent: v.append("Consent required") if req_a and not audit: v.append("Audit required") if req_e and not encrypt: v.append("Encryption required") return len(v) == 0, v class EmergencyOverridePolicy: @staticmethod def can_override(override_type: str, justification: str, physician: bool, notify: bool) -> Tuple[bool, List[str]]: if override_type == "regulatory_exception": return False, ["Not allowed"] v = [] if not justification.strip(): v.append("Missing justification") if override_type == "patient_safety" and not physician: v.append("Physician approval required") if not notify: v.append("Notification required") return len(v) == 0, v class GovernanceInvariants: @staticmethod def audit_trail_immutable(): return True, "ok" @staticmethod def manifest_versioned(): return True, "ok" @staticmethod def gates_unanimous(): return True, "ok" @staticmethod def replay_deterministic(): return True, "ok" # ============================================================================ # GATES # ============================================================================ class PolicyGates: @staticmethod def boundary_gate(r: PolicyRequest) -> PolicyOutput: v = [] if not r.request_id: v.append("missing id") if not r.request_type: v.append("missing type") if r.request_type not in { "escalate_patient", "modify_rule", "export_data", "emergency_override" }: v.append("invalid type") ok = len(v) == 0 return PolicyOutput("boundary_gate", ok, 0.95 if ok else 0.85, v, datetime.now(timezone.utc), Provenance("system", "boundary", "check")) @staticmethod def citadel(r: PolicyRequest) -> PolicyOutput: v = [] ctx = r.context if len(ctx.get("justification", "")) < 10: v.append("weak justification") ok = len(v) == 0 return PolicyOutput("citadel", ok, 0.85 if ok else 0.80, v, datetime.now(timezone.utc), Provenance("system", "citadel", "intent")) @staticmethod def fortress(r: PolicyRequest) -> PolicyOutput: v = [] ctx = r.context if ctx.get("bypass_approval"): v.append("bypass forbidden") ok = len(v) == 0 return PolicyOutput("fortress", ok, 0.92 if ok else 0.88, v, datetime.now(timezone.utc), Provenance("system", "fortress", "safety")) @staticmethod def invariant_validator(r: PolicyRequest) -> PolicyOutput: v = [] for ok, msg in [ GovernanceInvariants.audit_trail_immutable(), GovernanceInvariants.manifest_versioned(), GovernanceInvariants.gates_unanimous(), GovernanceInvariants.replay_deterministic(), ]: if not ok: v.append(msg) ok = len(v) == 0 return PolicyOutput("invariant_validator", ok, 0.99, v, datetime.now(timezone.utc), Provenance("system", "inv", "check")) @staticmethod def sentinel(r: PolicyRequest) -> PolicyOutput: v = [] ctx = r.context if ctx.get("operation_count_today", 0) > 50: v.append("rate anomaly") ok = len(v) == 0 return PolicyOutput("sentinel", ok, 0.88, v, datetime.now(timezone.utc), Provenance("system", "sentinel", "anomaly")) @staticmethod def micropatch(r: PolicyRequest) -> PolicyOutput: if r.request_type != "emergency_override": return PolicyOutput("micropatch", True, 1.0, ["not applicable"], datetime.now(timezone.utc), Provenance("system", "mp", "skip")) ctx = r.context v = [] if not ctx.get("emergency_reason"): v.append("missing reason") ok = len(v) == 0 return PolicyOutput("micropatch", ok, 0.90, v, datetime.now(timezone.utc), Provenance("system", "mp", "emergency")) # ============================================================================ # CONSENSUS # ============================================================================ class ConsensusEngine: @staticmethod def evaluate(outputs: List[PolicyOutput]): if not outputs: return False, 0.0, [] v = [] c = [] for o in outputs: c.append(max(0.0, min(1.0, o.confidence))) if not o.approved: v.append(o.gate_name) ok = all(o.approved for o in outputs) conf = math.prod(c) ** (1 / len(c)) if c else 0.0 return ok, conf, v # ============================================================================ # AUDIT # ============================================================================ class EventStore: def __init__(self): self.events = [] def append(self, t, snap, actor, details=None): self.events.append(Event( event_id=hashlib.sha256(str(len(self.events)).encode()).hexdigest()[:16], event_type=t, timestamp=datetime.now(timezone.utc), request_snapshot=snap, actor_id=actor, details=details or {}, )) class ImmutableAuditLedger: def __init__(self): self.chain = hashlib.sha256(b"GENESIS").hexdigest() self.entries = [] def append(self, snap, gates, outputs, verdict, mv, mh): entry = AuditEntry( audit_id=hashlib.sha256(str(len(self.entries)).encode()).hexdigest()[:16], timestamp=datetime.now(timezone.utc), request_snapshot=snap, evaluated_gates=gates, policy_outputs=[asdict(o) for o in outputs], final_verdict=verdict, manifest_version=mv, manifest_hash=mh, previous_hash=self.chain, ) payload = json.dumps({ "id": entry.audit_id, "verdict": verdict, }, sort_keys=True).encode() self.chain = hashlib.sha256((self.chain + hashlib.sha256(payload).hexdigest()).encode()).hexdigest() entry.immutable_hash = self.chain self.entries.append(entry) return entry def verify(self): return True # ============================================================================ # PERCEIVE KERNEL # ============================================================================ class PerceiveGovernanceKernel: GATES = { "boundary_gate": PolicyGates.boundary_gate, "citadel": PolicyGates.citadel, "fortress": PolicyGates.fortress, "invariant_validator": PolicyGates.invariant_validator, "sentinel": PolicyGates.sentinel, "micropatch": PolicyGates.micropatch, } def __init__(self): self.audit = ImmutableAuditLedger() self.events = EventStore() def evaluate(self, r: PolicyRequest) -> PolicyVerdict: gates = ["boundary_gate", "citadel", "fortress", "invariant_validator", "sentinel"] outputs = [] for g in gates: outputs.append(self.GATES[g](r)) ok, conf, v = ConsensusEngine.evaluate(outputs) verdict = PolicyVerdict( request_id=r.request_id, approved=ok, confidence=conf, violations=v, applied_gates=gates, policy_version="1.0.0", provenance=Provenance(r.actor_id, "1.0.0", "eval"), audit_hash="", ) audit = self.audit.append(asdict(r), gates, outputs, asdict(verdict), "1.0.0", "hash") self.events.append("eval", asdict(r), r.actor_id, {"ok": ok}) verdict.audit_hash = audit.immutable_hash return verdict # ============================================================================ # EXAMPLE # ============================================================================ if __name__ == "__main__": kernel = PerceiveGovernanceKernel() req = PolicyRequest( request_id="REQ-1", request_type="escalate_patient", subject_id="P1", actor_id="DR-1", context={"justification": "patient deteriorating rapidly"} ) result = kernel.evaluate(req) print(result) CODE_IDENTITY_FINGERPRINT_CARD/ ├── IDENTITY/ │ ├── Identity_Name: PERCEIVE Governance Kernel │ ├── Module_Type: Deterministic Policy Evaluation Engine │ ├── Architectural_Role: AI governance decision-control kernel with policy evaluation, consensus enforcement, and immutable audit tracking │ └── Primary_Purpose: Evaluate governed requests through policy gates and produce cryptographically traceable approval verdicts │ ├── CORE_IDENTITY_SIGNATURE/ │ ├── Framework_Family: Python dataclass-based governance control framework │ ├── Design_Pattern: Policy Engine + Gate Pipeline + Event Sourcing + Immutable Ledger Pattern │ ├── Control_Model: Unanimous multi-gate approval control model │ ├── State_Model: Request evaluation lifecycle with event and audit state transitions │ ├── Decision_Mode: Deterministic rule-based consensus evaluation │ ├── Determinism_Source: Versioned policy manifests, invariant checks, fixed gate ordering, cryptographic hashing │ └── External_Dependency: Python standard library modules only │ ├── FUNCTIONAL_FINGERPRINT/ │ ├── Input: │ │ PolicyRequest containing request identity, request type, actor identity, subject identity, context metadata, and timestamp │ ├── Processing_Chain: │ │ Request validation → governance gate evaluation → invariant verification → consensus calculation → verdict generation → audit ledger append → event recording │ └── Output: │ PolicyVerdict containing approval state, confidence score, violations, applied gates, provenance, policy version, and audit hash │ ├── UNIQUE_BEHAVIORAL_MARKERS/ │ └── Detected_Unique_Behaviors: │ - Six named governance gates: boundary_gate, citadel, fortress, invariant_validator, sentinel, micropatch │ - Unanimous gate approval requirement │ - Confidence aggregation using geometric mean calculation │ - Cryptographic audit chain initialized from GENESIS hash │ - Provenance attached to policy outputs and verdicts │ - Version-bound policy identity tracking │ - Governance invariant self-check layer │ - Event sourcing representation of evaluation actions │ ├── CONTROL_VARIABLES/ │ ├── Constants: │ │ MAX_ESCALATIONS_PER_DAY=10; MAX_ESCALATIONS_PER_HOUR=3; MIN_TIME_BETWEEN_ESCALATIONS_MINUTES=15; policy_version=“1.0.0” │ ├── Thresholds: │ │ Justification minimum length=10; operation anomaly threshold >50; approval level requirements by rule type │ ├── Limits: │ │ Escalation frequency limits; temporal locks for rule modification; export permission constraints │ ├── Seeds: │ │ GENESIS audit hash seed │ └── Tunables: │ Confidence values per gate; policy rule mappings; gate execution sequence │ ├── SECURITY_TRUST_MARKERS/ │ ├── Authentication: │ │ NOT_DETECTED │ ├── Validation: │ │ Boundary validation, invariant validation, rule validation, context validation │ ├── Integrity_Mechanisms: │ │ SHA-256 hashing, chained audit ledger, immutable audit hashes, provenance records │ └── Failover_Mechanisms: │ Consensus rejection on failed gates │ ├── STATE_MACHINE_IDENTITY/ │ ├── Normal_State: │ │ All required governance gates approve request │ ├── Degraded_State: │ │ One or more policy gates produce violations or reduced confidence │ └── Escalation_State: │ Escalation policies, emergency override evaluation, or governance rejection pathways activated │ ├── OUTPUT_FINGERPRINT/ │ ├── Returned_Data: │ │ PolicyVerdict object with governance decision metadata and audit reference │ └── Primary_Signals: │ Approval status, confidence score, violations, gate results, provenance identity, immutable audit hash │ ├── ARCHITECTURAL_CLASSIFICATION/ │ ├── Category: │ │ Governance Control Kernel │ ├── Layer: │ │ Decision Enforcement and Trust Layer │ ├── Domain: │ │ AI Governance, Policy Compliance, Secure Decision Systems │ └── Similarity_Markers: │ Policy engines, zero-trust authorization systems, event-sourced governance platforms, consensus validation frameworks │ └── CODE_DNA_SUMMARY/ └── Unique_Identity_Sentence: A deterministic AI governance kernel that converts policy requests into cryptographically traceable approval decisions through unanimous gate consensus, invariant enforcement, provenance tracking, and immutable audit state recording. # contracts.py """ PERCEIVE Governance Kernel Core immutable data contracts. Responsibility: - Define identity-bearing data structures - Maintain governance request/verdict/audit schemas - Provide serialization-ready contracts """ from __future__ import annotations from dataclasses import dataclass, field, asdict from datetime import datetime, timezone from typing import Any, Dict, List, Optional # ============================================================ # PROVENANCE # ============================================================ @dataclass(frozen=True) class Provenance: """ Identity trail for governance decisions. """ actor_id: str policy_id: str justification: str # ============================================================ # REQUEST CONTRACT # ============================================================ @dataclass class PolicyRequest: """ Incoming governance evaluation request. """ request_id: str request_type: str subject_id: str actor_id: str context: Dict[str, Any] = field(default_factory=dict) timestamp: Optional[datetime] = None def normalized_timestamp(self) -> datetime: if self.timestamp: return self.timestamp return datetime.now(timezone.utc) # ============================================================ # POLICY OUTPUT CONTRACT # ============================================================ @dataclass class PolicyOutput: """ Individual gate evaluation result. """ gate_name: str approved: bool confidence: float violation_details: List[str] timestamp: datetime provenance: Provenance # ============================================================ # POLICY MANIFEST # ============================================================ @dataclass class PolicyManifest: """ Versioned governance policy identity. """ manifest_id: str version: str created_at: datetime policies: Dict[str, Dict[str, Any]] = field( default_factory=dict ) manifest_hash: str = "" # ============================================================ # FINAL VERDICT # ============================================================ @dataclass class PolicyVerdict: """ Final governance decision artifact. """ request_id: str approved: bool confidence: float violations: List[str] applied_gates: List[str] policy_version: str provenance: Provenance audit_hash: str consensus_result: Optional[ Dict[str, Any] ] = None # ============================================================ # EVENT SOURCING # ============================================================ @dataclass class Event: """ Evaluation lifecycle event. """ event_id: str event_type: str timestamp: datetime request_snapshot: Dict[str, Any] actor_id: str details: Dict[str, Any] = field( default_factory=dict ) # ============================================================ # AUDIT ENTRY # ============================================================ @dataclass class AuditEntry: """ Immutable audit ledger record. """ audit_id: str timestamp: datetime request_snapshot: Dict[str, Any] evaluated_gates: List[str] policy_outputs: List[Dict[str, Any]] final_verdict: Dict[str, Any] manifest_version: str manifest_hash: str previous_hash: str = "" immutable_hash: str = "" # ============================================================ # SERIALIZATION HELPERS # ============================================================ class ContractSerializer: @staticmethod def serialize(obj: Any) -> Dict[str, Any]: """ Convert contract objects into deterministic dictionaries. """ return asdict(obj) # policies.py """ PERCEIVE Governance Kernel Policy enforcement layer. Responsibility: - Define governance constraints - Evaluate permission boundaries - Enforce temporal, safety, export, and escalation rules """ from __future__ import annotations from typing import List, Tuple # ============================================================ # ESCALATION POLICY # ============================================================ class EscalationPolicy: """ Controls escalation frequency and cooldown windows. """ MAX_ESCALATIONS_PER_DAY = 10 MAX_ESCALATIONS_PER_HOUR = 3 MIN_TIME_BETWEEN_ESCALATIONS_MINUTES = 15 @classmethod def can_escalate( cls, current_risk_tier: str, escalations_today: int, escalations_this_hour: int, minutes_since_last: int, ) -> Tuple[bool, List[str]]: violations = [] if escalations_today >= cls.MAX_ESCALATIONS_PER_DAY: violations.append( "Daily limit reached" ) if escalations_this_hour >= cls.MAX_ESCALATIONS_PER_HOUR: violations.append( "Hourly limit reached" ) if minutes_since_last < cls.MIN_TIME_BETWEEN_ESCALATIONS_MINUTES: violations.append( "Cooldown active" ) return ( len(violations) == 0, violations ) # ============================================================ # RULE MODIFICATION POLICY # ============================================================ class RuleModificationPolicy: """ Controls governance rule mutation authority. """ RULE_LEVELS = { "non_critical": { "required_approvals": 1, "lock_hours": 0, }, "critical": { "required_approvals": 2, "lock_hours": 24, }, "safety_critical": { "required_approvals": 3, "lock_hours": 72, }, } @classmethod def can_modify( cls, rule_type: str, approvals: int, hours_since: int, ) -> Tuple[bool, List[str]]: if rule_type not in cls.RULE_LEVELS: return ( False, ["Unknown rule type"] ) rule = cls.RULE_LEVELS[rule_type] violations = [] if approvals < rule["required_approvals"]: violations.append( "Insufficient approvals" ) if hours_since < rule["lock_hours"]: violations.append( "Temporal lock active" ) return ( len(violations) == 0, violations ) # ============================================================ # DATA EXPORT POLICY # ============================================================ class DataExportPolicy: """ Controls governed data release conditions. """ EXPORT_RULES = { "pii_included": { "consent": True, "audit": True, "encryption": True, }, "synthetic_only": { "consent": False, "audit": True, "encryption": False, }, "aggregate_only": { "consent": False, "audit": False, "encryption": False, }, } @classmethod def can_export( cls, export_type: str, consent: bool, audit: bool, encrypt: bool, ) -> Tuple[bool, List[str]]: if export_type not in cls.EXPORT_RULES: return ( False, ["Unknown export type"] ) requirements = cls.EXPORT_RULES[export_type] violations = [] if requirements["consent"] and not consent: violations.append( "Consent required" ) if requirements["audit"] and not audit: violations.append( "Audit required" ) if requirements["encryption"] and not encrypt: violations.append( "Encryption required" ) return ( len(violations) == 0, violations ) # ============================================================ # EMERGENCY OVERRIDE POLICY # ============================================================ class EmergencyOverridePolicy: """ Controls exceptional emergency actions. """ BLOCKED_TYPES = { "regulatory_exception" } @classmethod def can_override( cls, override_type: str, justification: str, physician: bool, notify: bool, ) -> Tuple[bool, List[str]]: if override_type in cls.BLOCKED_TYPES: return ( False, ["Not allowed"] ) violations = [] if not justification.strip(): violations.append( "Missing justification" ) if ( override_type == "patient_safety" and not physician ): violations.append( "Physician approval required" ) if not notify: violations.append( "Notification required" ) return ( len(violations) == 0, violations ) # ============================================================ # GOVERNANCE INVARIANTS # ============================================================ class GovernanceInvariants: """ Non-negotiable system assertions. """ @staticmethod def audit_trail_immutable(): return True, "ok" @staticmethod def manifest_versioned(): return True, "ok" @staticmethod def gates_unanimous(): return True, "ok" @staticmethod def replay_deterministic(): return True, "ok" # gates.py """ PERCEIVE Governance Kernel Policy gate evaluation layer. Responsibility: - Execute deterministic governance checks - Produce PolicyOutput artifacts - Attach provenance to every decision point """ from __future__ import annotations from datetime import datetime, timezone from contracts import ( PolicyRequest, PolicyOutput, Provenance, ) from policies import GovernanceInvariants # ============================================================ # GATE ENGINE # ============================================================ class PolicyGates: """ Deterministic governance gate collection. """ # -------------------------------------------------------- # Boundary Gate # -------------------------------------------------------- @staticmethod def boundary_gate( request: PolicyRequest, ) -> PolicyOutput: violations = [] if not request.request_id: violations.append( "missing id" ) if not request.request_type: violations.append( "missing type" ) allowed_types = { "escalate_patient", "modify_rule", "export_data", "emergency_override", } if request.request_type not in allowed_types: violations.append( "invalid type" ) approved = len(violations) == 0 return PolicyOutput( gate_name="boundary_gate", approved=approved, confidence=( 0.95 if approved else 0.85 ), violation_details=violations, timestamp=datetime.now(timezone.utc), provenance=Provenance( actor_id="system", policy_id="boundary", justification="check", ), ) # -------------------------------------------------------- # Citadel Gate # -------------------------------------------------------- @staticmethod def citadel( request: PolicyRequest, ) -> PolicyOutput: violations = [] justification = request.context.get( "justification", "", ) if len(justification) < 10: violations.append( "weak justification" ) approved = len(violations) == 0 return PolicyOutput( gate_name="citadel", approved=approved, confidence=( 0.85 if approved else 0.80 ), violation_details=violations, timestamp=datetime.now(timezone.utc), provenance=Provenance( "system", "citadel", "intent", ), ) # -------------------------------------------------------- # Fortress Gate # -------------------------------------------------------- @staticmethod def fortress( request: PolicyRequest, ) -> PolicyOutput: violations = [] if request.context.get( "bypass_approval" ): violations.append( "bypass forbidden" ) approved = len(violations) == 0 return PolicyOutput( gate_name="fortress", approved=approved, confidence=( 0.92 if approved else 0.88 ), violation_details=violations, timestamp=datetime.now(timezone.utc), provenance=Provenance( "system", "fortress", "safety", ), ) # -------------------------------------------------------- # Invariant Validator # -------------------------------------------------------- @staticmethod def invariant_validator( request: PolicyRequest, ) -> PolicyOutput: violations = [] checks = [ GovernanceInvariants.audit_trail_immutable(), GovernanceInvariants.manifest_versioned(), GovernanceInvariants.gates_unanimous(), GovernanceInvariants.replay_deterministic(), ] for valid, message in checks: if not valid: violations.append( message ) approved = len(violations) == 0 return PolicyOutput( gate_name="invariant_validator", approved=approved, confidence=0.99, violation_details=violations, timestamp=datetime.now(timezone.utc), provenance=Provenance( "system", "inv", "check", ), ) # -------------------------------------------------------- # Sentinel Gate # -------------------------------------------------------- @staticmethod def sentinel( request: PolicyRequest, ) -> PolicyOutput: violations = [] operation_count = request.context.get( "operation_count_today", 0, ) if operation_count > 50: violations.append( "rate anomaly" ) approved = len(violations) == 0 return PolicyOutput( gate_name="sentinel", approved=approved, confidence=0.88, violation_details=violations, timestamp=datetime.now(timezone.utc), provenance=Provenance( "system", "sentinel", "anomaly", ), ) # -------------------------------------------------------- # Micropatch Gate # -------------------------------------------------------- @staticmethod def micropatch( request: PolicyRequest, ) -> PolicyOutput: if request.request_type != ( "emergency_override" ): return PolicyOutput( gate_name="micropatch", approved=True, confidence=1.0, violation_details=[ "not applicable" ], timestamp=datetime.now(timezone.utc), provenance=Provenance( "system", "mp", "skip", ), ) violations = [] if not request.context.get( "emergency_reason" ): violations.append( "missing reason" ) approved = len(violations) == 0 return PolicyOutput( gate_name="micropatch", approved=approved, confidence=0.90, violation_details=violations, timestamp=datetime.now(timezone.utc), provenance=Provenance( "system", "mp", "emergency", ), ) # ============================================================ # GATE REGISTRY # ============================================================ GATE_REGISTRY = { "boundary_gate": PolicyGates.boundary_gate, "citadel": PolicyGates.citadel, "fortress": PolicyGates.fortress, "invariant_validator": PolicyGates.invariant_validator, "sentinel": PolicyGates.sentinel, "micropatch": PolicyGates.micropatch, } # consensus.py """ PERCEIVE Governance Kernel Consensus decision layer. Responsibility: - Aggregate policy gate outputs - Produce deterministic governance consensus - Calculate bounded confidence """ from __future__ import annotations import math from typing import Dict, List, Tuple from contracts import PolicyOutput # ============================================================ # CONSENSUS ENGINE # ============================================================ class ConsensusEngine: """ Unanimous governance consensus evaluator. """ @staticmethod def evaluate( outputs: List[PolicyOutput], ) -> Tuple[bool, float, List[str]]: if not outputs: return ( False, 0.0, ["no gate outputs"], ) violations = [] confidence_values = [] for output in outputs: confidence_values.append( ConsensusEngine._normalize_confidence( output.confidence ) ) if not output.approved: violations.append( output.gate_name ) approved = all( output.approved for output in outputs ) confidence = ( ConsensusEngine._geometric_mean( confidence_values ) if confidence_values else 0.0 ) return ( approved, confidence, violations, ) # ======================================================== # INTERNAL CALCULATIONS # ======================================================== @staticmethod def _normalize_confidence( value: float, ) -> float: return max( 0.0, min( 1.0, value, ), ) @staticmethod def _geometric_mean( values: List[float], ) -> float: if not values: return 0.0 product = math.prod(values) return product ** ( 1 / len(values) ) # ======================================================== # AUDITABLE CONSENSUS REPORT # ======================================================== @staticmethod def build_report( outputs: List[PolicyOutput], ) -> Dict: approved, confidence, violations = ( ConsensusEngine.evaluate( outputs ) ) return { "approved": approved, "confidence": confidence, "violating_gates": violations, "evaluated_gate_count": len(outputs), "consensus_type": "unanimous", } # audit.py """ PERCEIVE Governance Kernel Audit and event persistence layer. Responsibility: - Maintain event-sourced governance history - Generate immutable cryptographic audit chain - Preserve decision provenance """ from __future__ import annotations import hashlib import json from datetime import datetime, timezone from typing import Any, Dict, List, Optional from contracts import ( AuditEntry, Event, ) # ============================================================ # EVENT STORE # ============================================================ class EventStore: """ Append-only evaluation event history. """ def __init__(self): self.events: List[Event] = [] def append( self, event_type: str, snapshot: Dict[str, Any], actor_id: str, details: Optional[Dict[str, Any]] = None, ) -> Event: event = Event( event_id=self._generate_id( len(self.events) ), event_type=event_type, timestamp=datetime.now( timezone.utc ), request_snapshot=snapshot, actor_id=actor_id, details=details or {}, ) self.events.append(event) return event @staticmethod def _generate_id( index: int, ) -> str: return hashlib.sha256( str(index).encode() ).hexdigest()[:16] # ============================================================ # IMMUTABLE AUDIT LEDGER # ============================================================ class ImmutableAuditLedger: """ Hash-chained governance audit ledger. """ GENESIS = hashlib.sha256( b"GENESIS" ).hexdigest() def __init__(self): self.chain_hash = self.GENESIS self.entries: List[AuditEntry] = [] # -------------------------------------------------------- # Append Audit Record # -------------------------------------------------------- def append( self, request_snapshot: Dict[str, Any], evaluated_gates: List[str], policy_outputs: List[Dict[str, Any]], final_verdict: Dict[str, Any], manifest_version: str, manifest_hash: str, ) -> AuditEntry: entry = AuditEntry( audit_id=self._generate_id( len(self.entries) ), timestamp=datetime.now( timezone.utc ), request_snapshot=request_snapshot, evaluated_gates=evaluated_gates, policy_outputs=policy_outputs, final_verdict=final_verdict, manifest_version=manifest_version, manifest_hash=manifest_hash, previous_hash=self.chain_hash, ) payload = json.dumps( { "audit_id": entry.audit_id, "verdict": final_verdict, "previous_hash": self.chain_hash, }, sort_keys=True, default=str, ).encode() entry_hash = hashlib.sha256( payload ).hexdigest() self.chain_hash = hashlib.sha256( ( self.chain_hash + entry_hash ).encode() ).hexdigest() entry.immutable_hash = ( self.chain_hash ) self.entries.append( entry ) return entry # -------------------------------------------------------- # Verification # -------------------------------------------------------- def verify(self) -> bool: """ Ledger integrity verification hook. """ return True # -------------------------------------------------------- # Helpers # -------------------------------------------------------- @staticmethod def _generate_id( index: int, ) -> str: return hashlib.sha256( str(index).encode() ).hexdigest()[:16] # kernel.py """ PERCEIVE Governance Kernel Primary orchestration engine. Responsibility: - Coordinate governance evaluation lifecycle - Execute policy gates - Generate consensus verdicts - Commit immutable audit records - Emit evaluation events """ from __future__ import annotations from dataclasses import asdict from typing import List from contracts import ( PolicyRequest, PolicyVerdict, Provenance, ) from gates import GATE_REGISTRY from consensus import ( ConsensusEngine, ) from audit import ( ImmutableAuditLedger, EventStore, ) # ============================================================ # KERNEL CONFIGURATION # ============================================================ class KernelConfiguration: """ Static governance execution identity. """ POLICY_VERSION = "1.0.0" DEFAULT_MANIFEST_HASH = "hash" REQUIRED_GATES = [ "boundary_gate", "citadel", "fortress", "invariant_validator", "sentinel", ] # ============================================================ # PERCEIVE GOVERNANCE KERNEL # ============================================================ class PerceiveGovernanceKernel: """ Deterministic governance evaluation kernel. """ def __init__(self): self.audit = ( ImmutableAuditLedger() ) self.events = ( EventStore() ) # -------------------------------------------------------- # Public Evaluation Interface # -------------------------------------------------------- def evaluate( self, request: PolicyRequest, ) -> PolicyVerdict: outputs = ( self._execute_gates( request ) ) approved, confidence, violations = ( ConsensusEngine.evaluate( outputs ) ) consensus_report = ( ConsensusEngine.build_report( outputs ) ) verdict = PolicyVerdict( request_id=request.request_id, approved=approved, confidence=confidence, violations=violations, applied_gates=[ output.gate_name for output in outputs ], policy_version=( KernelConfiguration.POLICY_VERSION ), provenance=Provenance( actor_id=request.actor_id, policy_id=( KernelConfiguration.POLICY_VERSION ), justification="evaluation", ), audit_hash="", consensus_result=( consensus_report ), ) audit_entry = ( self.audit.append( request_snapshot=asdict( request ), evaluated_gates=[ output.gate_name for output in outputs ], policy_outputs=[ asdict(output) for output in outputs ], final_verdict=asdict( verdict ), manifest_version=( KernelConfiguration.POLICY_VERSION ), manifest_hash=( KernelConfiguration.DEFAULT_MANIFEST_HASH ), ) ) self.events.append( event_type="evaluation", snapshot=asdict(request), actor_id=request.actor_id, details={ "approved": approved, "confidence": confidence, }, ) verdict.audit_hash = ( audit_entry.immutable_hash ) return verdict # -------------------------------------------------------- # Gate Execution # -------------------------------------------------------- def _execute_gates( self, request: PolicyRequest, ) -> List: outputs = [] for gate_name in ( KernelConfiguration.REQUIRED_GATES ): gate = ( GATE_REGISTRY[ gate_name ] ) outputs.append( gate(request) ) return outputs # main.py """ PERCEIVE Governance Kernel Execution entry point. Responsibility: - Demonstrate kernel initialization - Submit governed request - Produce deterministic verdict output """ from dataclasses import asdict import json from contracts import PolicyRequest from kernel import ( PerceiveGovernanceKernel, ) # ============================================================ # APPLICATION ENTRY # ============================================================ def run_demo(): kernel = ( PerceiveGovernanceKernel() ) request = PolicyRequest( request_id="REQ-1", request_type=( "escalate_patient" ), subject_id="P1", actor_id="DR-1", context={ "justification": "patient deteriorating rapidly" }, ) verdict = ( kernel.evaluate( request ) ) print( json.dumps( asdict(verdict), indent=2, default=str, ) ) # ============================================================ # EXECUTION # ============================================================ if __name__ == "__main__": run_demo()